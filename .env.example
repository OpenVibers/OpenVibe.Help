# OpenVibe.Help — environment (production: /etc/openvibe/help.env). Names only; never commit values.

NODE_ENV=production
PORT=5020
HOST=127.0.0.1
BASE_URL=https://openvibe.help
TRUST_PROXY=2
# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh help: the runtime role through PgBouncer,
# the owner on a direct connection (migrations), and Valkey (shared limit counters).
# Without DATABASE_URL, development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=ov:help:
# Per-caller limits (server/http/caller-limits.js): requests one caller may make to the API per minute and per hour.
#HELP_LIMITS_MINUTE=120
#HELP_LIMITS_HOUR=3000

# OpenVibe.Network: SSO (OAuth client `help`, PKCE S256) and its JWKS; app tokens for audience openvibe.help.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=help
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://openvibe.help/auth/callback
# HELP_AUDIENCE=openvibe.help

# optional: defaults to true in production
# COOKIE_SECURE=true
